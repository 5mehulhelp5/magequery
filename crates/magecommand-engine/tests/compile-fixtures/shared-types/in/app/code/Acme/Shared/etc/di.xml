<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- shared="false" on the TYPE lands in the `shared` metadata section. -->
    <type name="Acme\Shared\Model\PerRequest" shared="false"/>
    <type name="Acme\Shared\Model\Singleton" shared="true"/>
    <type name="Acme\Shared\Model\Holder">
        <arguments>
            <argument name="fresh" xsi:type="object" shared="false">Acme\Shared\Model\PerRequest</argument>
            <argument name="one" xsi:type="object" shared="true">Acme\Shared\Model\Singleton</argument>
        </arguments>
    </type>
</config>
