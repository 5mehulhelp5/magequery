<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Arguments on an INTERFACE are an inheritance source only: the
         interface is never instantiable and gets no compiled entry. -->
    <type name="Acme\Iface\Api\SourceInterface">
        <arguments>
            <argument name="label" xsi:type="string">from-interface</argument>
            <argument name="items" xsi:type="array">
                <item name="i" xsi:type="string">iface</item>
            </argument>
        </arguments>
    </type>
    <!-- The parent CLASS also declares them. ClassReader returns the parent
         first and interfaces after, and the merge is last-wins, so the
         INTERFACE outranks the parent class. -->
    <type name="Acme\Iface\Model\Base">
        <arguments>
            <argument name="label" xsi:type="string">from-parent</argument>
            <argument name="items" xsi:type="array">
                <item name="p" xsi:type="string">parent</item>
            </argument>
        </arguments>
    </type>
</config>
